# Host port used by Docker Compose.
APP_PORT=8501

# Optional Streamable HTTP MCP service exposed by the `mcp` Compose profile.
MCP_PORT=8000

# Optional. Defaults to data/chroma inside the current project.
POLICY_DB_PATH=

# OpenAI-compatible multimodal inference. Never commit a real key.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_RESPONSE_FORMAT=auto
LLM_FALLBACK_MODELS=

# Alibaba Cloud Model Studio (Bailian), China/Beijing example.
# Copy this file to .env and use the exact Base URL shown in your workspace.
# Newer workspaces may use a workspace-specific maas.aliyuncs.com URL.
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-vl-plus
# LLM_FALLBACK_MODELS=qwen-vl-max,qwen3.5-omni-plus
# LLM_RESPONSE_FORMAT=json_object

# OpenRouter alternative:
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o
# LLM_TIMEOUT_SECONDS=120
# LLM_REQUIRE_PARAMETERS=true
# LLM_ALLOW_FALLBACKS=false
# LLM_PROVIDER_ORDER=OpenAI
