# Host port used by Docker Compose.
APP_PORT=8501

# Optional. Defaults to data/chroma inside the current project.
POLICY_DB_PATH=

# OpenAI-compatible multimodal inference.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# OpenRouter alternative:
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o
# LLM_TIMEOUT_SECONDS=120
# LLM_REQUIRE_PARAMETERS=true
# LLM_ALLOW_FALLBACKS=false
# LLM_PROVIDER_ORDER=OpenAI
